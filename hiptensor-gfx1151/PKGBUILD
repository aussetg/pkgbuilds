# Maintainer: Local gfx1151 ROCm add-on package
# Based on Arch Linux hiptensor packaging, adapted for rocm-gfx1151-bin / TheRock ROCm 7.13 preview.

pkgname=hiptensor-gfx1151
pkgver=7.13.0rc2
pkgrel=1
pkgdesc='AMD C++ library for accelerating tensor primitives for rocm-gfx1151-bin'
arch=('x86_64')
url='https://rocm.docs.amd.com/projects/hipTensor/en/latest/'
license=('MIT')
depends=('rocm-gfx1151-bin' 'glibc' 'gcc-libs')
makedepends=('git' 'cmake' 'ninja' 'rocm-gfx1151-bin')
# Do not provide/conflict with "hiptensor": rocm-gfx1151-bin currently declares
# conflicts=(hiptensor) while also missing the files.
_git='https://github.com/ROCm/rocm-libraries'
_rocm_libraries_commit=f664f44c90ae22e860738f8c9793a019eb1975e1  # from /opt/rocm/share/therock/therock_manifest.json
source=("rocm-libraries::git+$_git.git#commit=$_rocm_libraries_commit")
sha256sums=('SKIP')
options=(!lto)

_prepare_rocm_env() {
  export ROCM_PATH=/opt/rocm
  export HIP_PATH=/opt/rocm
  export HIP_PLATFORM=amd
  export HIP_DEVICE_LIB_PATH=/opt/rocm/lib/llvm/amdgcn/bitcode
  export PATH="/opt/rocm/bin:/opt/rocm/lib/llvm/bin:${PATH}"
}

build() {
  _prepare_rocm_env
  local gpu_targets="${AMDGPU_TARGETS:-${GPU_TARGETS:-gfx1151}}"
  local cmake_args=(
    -Wno-dev
    -S rocm-libraries/projects/hiptensor
    -G Ninja
    -B build
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_CXX_COMPILER=/opt/rocm/bin/amdclang++
    -D CMAKE_CXX_FLAGS="${CXXFLAGS} -fcf-protection=none"
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    -D ROCM_PATH=/opt/rocm
    -D GPU_TARGETS="$gpu_targets"
    -D HIPTENSOR_BUILD_TESTS=OFF
    -D HIPTENSOR_BUILD_SAMPLES=OFF
    -D HIPTENSOR_BUILD_COMPRESSED_DBG=ON
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 rocm-libraries/projects/hiptensor/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
