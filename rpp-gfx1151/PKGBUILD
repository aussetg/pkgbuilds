# Maintainer: Local gfx1151 ROCm add-on package
# Based on Arch Linux rpp packaging, adapted for rocm-gfx1151-bin.

pkgname=rpp-gfx1151
pkgver=7.2.3
pkgrel=1
pkgdesc="AMD ROCm Performance Primitives for rocm-gfx1151-bin"
arch=('x86_64')
url="https://rocm.docs.amd.com/projects/rpp/en/latest/"
license=('MIT')
depends=('rocm-gfx1151-bin' 'openmp' 'glibc' 'gcc-libs')
makedepends=('cmake' 'rocm-gfx1151-bin')
# Do not provide/conflict with "rpp": rocm-gfx1151-bin currently declares
# conflicts=(rpp) while also missing the files.
_git='https://github.com/ROCm/rpp'
source=("rpp-$pkgver.tar.gz::$_git/archive/rocm-$pkgver.tar.gz")
sha256sums=('348c08e5079e5f68403570e593d4c2f72e4bdaafdd38a0e57725353a16b6a66e')

_prepare_rocm_env() {
  export ROCM_PATH=/opt/rocm
  export HIP_PATH=/opt/rocm
  export HIP_PLATFORM=amd
  export HIP_DEVICE_LIB_PATH=/opt/rocm/lib/llvm/amdgcn/bitcode
  export PATH="/opt/rocm/bin:/opt/rocm/lib/llvm/bin:${PATH}"
  CXXFLAGS+=" -fcf-protection=none"
}

build() {
  _prepare_rocm_env
  local gpu_targets="${AMDGPU_TARGETS:-${GPU_TARGETS:-gfx1151}}"
  local cmake_args=(
    -Wno-dev
    -B build
    -S "rpp-rocm-$pkgver"
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    -D CMAKE_C_COMPILER=/opt/rocm/bin/amdclang
    -D CMAKE_CXX_COMPILER=/opt/rocm/bin/amdclang++
    -D CMAKE_BUILD_TYPE=Release
    -D ROCM_PATH=/opt/rocm
    -D GPU_TARGETS="$gpu_targets"
    -D AMDGPU_TARGETS="$gpu_targets"
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "rpp-rocm-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
