# Maintainer: Local gfx1151 ROCm add-on package
# Based on Arch Linux hipfort packaging, adapted for rocm-gfx1151-bin.

pkgname=hipfort-gfx1151
pkgver=7.2.3
pkgrel=1
pkgdesc='Fortran interfaces for rocm-gfx1151-bin ROCm libraries'
arch=('x86_64')
url='https://rocm.docs.amd.com/projects/hipfort/en/latest/'
license=('MIT')
depends=('rocm-gfx1151-bin' 'bash')
makedepends=('git' 'cmake' 'rocm-gfx1151-bin')
optdepends=(
  'rocm-gfx1151-bin: ROCm libraries with Fortran bindings'
)
# Do not provide/conflict with "hipfort": rocm-gfx1151-bin currently declares
# conflicts=(hipfort) while also missing the files.
_git='https://github.com/ROCm/hipfort'
source=("hipfort::git+$_git.git#tag=rocm-$pkgver")
sha256sums=('SKIP')
options=(!strip)

_prepare_rocm_env() {
  export ROCM_PATH=/opt/rocm
  export HIP_PATH=/opt/rocm
  export HIP_PLATFORM=amd
  export HIP_DEVICE_LIB_PATH=/opt/rocm/lib/llvm/amdgcn/bitcode
  export PATH="/opt/rocm/bin:/opt/rocm/lib/llvm/bin:${PATH}"
}

build() {
  _prepare_rocm_env
  local cmake_args=(
    -Wno-dev
    -B build
    -S hipfort
    -D CMAKE_POLICY_VERSION_MINIMUM=3.5
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    -D ROCM_PATH=/opt/rocm
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 hipfort/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
